# Copy to .env and fill in. .env is gitignored -- never commit the real one.
#
# Read-only connection to the BeeHappy database on Railway
# (tables: beehives, sensors, data).
#
# sslmode=require is not optional: the Railway proxy is on the public internet,
# and without it the password travels in plaintext.
#
# Use the read-only grafana_ro role. The postgres superuser can DROP the live
# tables, and this is the project's production database -- not a copy.
DATABASE_URL=postgresql://grafana_ro:PASSWORD@crossover.proxy.rlwy.net:45838/railway?sslmode=require
